# Grand Studio — copy to .env.local and fill in values

# WebSocket relay for UE5 Commander plugin (browser ↔ plugin)
NEXT_PUBLIC_WS_URL=wss://grandstudio-ws.mydreamvalid35.workers.dev/ws

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (for subscriptions)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=
NEXT_PUBLIC_STRIPE_TEAM_PRICE_ID=

# AI 3D (Meshy)
MESHY_API_KEY=

# AI Music Studio (optional)
# HF_API_TOKEN=your_hugging_face_token_here
# Optional: MUSIC_API_BASE_URL=https://api-inference.huggingface.co/models/facebook/musicgen-small
