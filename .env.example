# Grand Studio — copy to .env.local and fill in values

# === Supabase (required — auth + database) ===
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# === Site ===
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# === Stripe (subscriptions) ===
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Pro tier ($4.99/mo). Create the price in the Stripe Dashboard (Phase 6), then paste the ID here.
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=

# === Resend (transactional email) ===
RESEND_API_KEY=

# === Upstash Redis (rate limiting — free tier download caps) ===
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# === Epic Games OAuth (Fab / Epic login) ===
EPIC_CLIENT_ID=
EPIC_CLIENT_SECRET=

# === Model source APIs ===
# Sketchfab browsing/import (Phase 3)
SKETCHFAB_API_TOKEN=
# Meshy (AI 3D generation + webhook) — remove if not integrating Meshy
MESHY_API_KEY=
MESHY_WEBHOOK_KEY=

# === Plugin BYOK AI (optional — used only by /api/plugin/command) ===
# The UE5 plugin's AI command endpoint. Set one of these if you use it.
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=

# === Plugin WebSocket (optional) ===
# NEXT_PUBLIC_WS_URL=
