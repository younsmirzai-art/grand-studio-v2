# Copy to .env and fill in values.
# Supabase: https://supabase.com/dashboard → Project → Settings → API
# OpenRouter: https://openrouter.ai/keys
# Upstash (optional): https://console.upstash.com

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

OPENROUTER_API_KEY=

# Google Gemini (plugin /api/plugin/command — used when set; falls back to OpenRouter)
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Sketchfab (optional — for 3D model search/download from Sketchfab)
# Get token from: https://sketchfab.com/settings/password
# SKETCHFAB_API_TOKEN=

# UE5 bridge (enable local relay / UE5 execution features)
NEXT_PUBLIC_UE5_BRIDGE_ENABLED=true

# Rate limiting (optional — works without these, just no rate limits)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe (for Pro/Team subscriptions)
# Get keys from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
